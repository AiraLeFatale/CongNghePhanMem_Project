# Địa chỉ gốc của backend khi build production (không có "/api" ở cuối).
# Để trống khi chạy dev: Vite proxy /api và /uploads sang backend.
VITE_API_URL=

# (Chỉ dùng cho `npm run dev` / `npm run preview`) backend mà proxy trỏ tới.
DEV_PROXY_TARGET=http://localhost:4000

# Nền bản đồ (tùy chọn). Mặc định dùng CARTO light; có thể đổi sang OSM:
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

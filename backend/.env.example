# Copy thành .env rồi chạy: node --env-file=.env src/server.js
PORT=4000
# Bắt buộc đổi khi chạy thật (chuỗi ngẫu nhiên dài)
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# Danh sách origin CMS được gọi API, cách nhau dấu phẩy; * = mọi origin (chỉ dùng khi dev)
CORS_ORIGIN=*
# Tên miền công khai (vd cnpm.dpdns.org). Có giá trị thì request http đi qua Cloudflare
# sẽ bị chuyển 301 sang https. Để trống khi chỉ chạy localhost.
PUBLIC_HOST=
DB_FILE=./data/narration.db
UPLOAD_DIR=./uploads
# Thư mục bản build website + CMS; mặc định ../web (để trống thì backend chỉ chạy API)
WEB_DIR=../web
# google-free | libretranslate | none
TRANSLATE_PROVIDER=google-free
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_KEY=
# google-free | none  (none: app dùng giọng đọc của điện thoại)
TTS_PROVIDER=google-free
# Tự dịch + tạo giọng đọc sau khi lưu POI: 1 = bật, 0 = tắt
AUTO_TRANSLATE_ON_SAVE=1
# Đếm người đang dùng: 2 = nhân đôi để demo (mặc định), 1 = số thật
LIVE_DEMO_FACTOR=2
# Phiên không gửi heartbeat trong khoảng này thì bị coi là đã rời đi (mili-giây)
LIVE_TTL_MS=45000
# Nhịp đẩy số liệu cho CMS qua SSE (mili-giây). 1000 = cập nhật mỗi 1 giây.
LIVE_SSE_INTERVAL_MS=1000
# Thanh toán VietQR. Mặc định giống tài khoản của bản deploy (chỉ dùng cho demo).
# Đặt PAYMENT_ACCOUNT= (rỗng) để tắt thanh toán.
PAYMENT_BANK_BIN=970436
PAYMENT_BANK_NAME=Vietcombank
PAYMENT_ACCOUNT=1019518779
PAYMENT_ACCOUNT_NAME=PHAM VAN HUNG
# Mật khẩu admin khi chạy seed
ADMIN_PASSWORD=admin123

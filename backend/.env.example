# Copy thành .env rồi chạy: node --env-file=.env src/server.js
PORT=4000
# Bắt buộc đổi khi chạy thật (chuỗi ngẫu nhiên dài)
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# Danh sách origin CMS được gọi API, cách nhau dấu phẩy; * = mọi origin (chỉ dùng khi dev)
CORS_ORIGIN=*
DB_FILE=./data/narration.db
UPLOAD_DIR=./uploads
# google-free | libretranslate | none
TRANSLATE_PROVIDER=google-free
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_KEY=
# google-free | none  (none: app dùng giọng đọc của điện thoại)
TTS_PROVIDER=google-free
# Mật khẩu admin khi chạy seed
ADMIN_PASSWORD=admin123

# Địa chỉ backend (không có /api ở cuối). Sao chép thành .env rồi sửa.
# - Điện thoại thật (Expo Go qua Wi-Fi): dùng IP LAN của máy chạy backend, KHÔNG dùng localhost.
# - Android emulator: http://10.0.2.2:4000   - iOS simulator: http://localhost:4000
# Bỏ trống → app tự lấy IP LAN của máy chạy Metro (hostUri) + cổng 4000.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

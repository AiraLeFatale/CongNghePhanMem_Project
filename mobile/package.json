{
  "name": "narration-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@types/jest": "30.0.0",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-location": "~58.0.17",
    "expo-router": "~58.0.23",
    "expo-speech": "~58.0.3",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-task-manager": "~58.0.12",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "leaflet": "^1.9.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "gen:leaflet": "node scripts/embed-leaflet.js",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*)"
    ]
  }
}
